<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.Android.AppWidgetContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Android.AppWidget.Container">
    <RelativeLayout
        android:gravity="center"
        android:background="@drawable/meridian_flowing_clock_radius_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/app_widget_mini_bg"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/health_flowing_clock_mini_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <AnalogClock
                    android:id="@+id/mf_clock_mini_clock"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:dial="@drawable/meridian_flowing_clock_bg"
                    android:hand_hour="@drawable/meridian_flowing_clock_hour_mini"
                    android:hand_minute="@drawable/meridian_flowing_clock_minute_mini"
                    android:layout_weight="2"/>
                <FrameLayout
                    android:id="@+id/mf_clock_mini_clock_manual"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="2">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/meridian_flowing_clock_bg"
                        android:scaleType="fitCenter"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/mf_clock_mini_clock_m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/meridian_flowing_clock_minute_mini"
                        android:scaleType="fitCenter"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/mf_clock_mini_clock_h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/meridian_flowing_clock_hour_mini"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3">
                    <TextClock
                        android:textSize="23dp"
                        android:textColor="#262220"
                        android:id="@+id/mf_clock_mini_clock_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="HH:mm"
                        android:format24Hour="HH:mm"
                        android:textFontWeight="900"/>
                    <TextView
                        android:textSize="23dp"
                        android:textColor="#262220"
                        android:id="@+id/mf_clock_mini_clock_text_manual"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00"
                        android:textFontWeight="900"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#262220"
                        android:id="@+id/mf_clock_mini_terrestrial_branch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未时 脾经"
                        android:textFontWeight="900"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="5dp"
                android:layout_marginHorizontal="5dp">
                <LinearLayout
                    android:gravity="center"
                    android:background="@drawable/rounded_color_white"
                    android:paddingLeft="3dp"
                    android:paddingTop="5dp"
                    android:paddingRight="3dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="5dp">
                    <TextView
                        android:textSize="8dp"
                        android:textColor="#ffffff"
                        android:id="@+id/mf_clock_mini_xie"
                        android:background="@drawable/meridian_flowing_clock_item_span"
                        android:paddingLeft="5dp"
                        android:paddingTop="3dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="泄"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="3dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#262220"
                        android:id="@+id/mf_clock_mini_xiexue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="小海"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:background="@drawable/rounded_color_white"
                    android:paddingLeft="3dp"
                    android:paddingTop="5dp"
                    android:paddingRight="3dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="5dp">
                    <TextView
                        android:textSize="8dp"
                        android:textColor="#ffffff"
                        android:id="@+id/mf_clock_mini_bu"
                        android:background="@drawable/meridian_flowing_clock_item_span"
                        android:paddingLeft="5dp"
                        android:paddingTop="3dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="补"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="3dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#262220"
                        android:id="@+id/mf_clock_mini_buxue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="小海"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="5dp"
                android:layout_marginHorizontal="5dp">
                <LinearLayout
                    android:gravity="center"
                    android:background="@drawable/rounded_color_white"
                    android:paddingLeft="3dp"
                    android:paddingTop="5dp"
                    android:paddingRight="3dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="5dp">
                    <TextView
                        android:textSize="8dp"
                        android:textColor="#ffffff"
                        android:id="@+id/mf_clock_mini_yuan"
                        android:background="@drawable/meridian_flowing_clock_item_span"
                        android:paddingLeft="5dp"
                        android:paddingTop="3dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="原"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="3dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#262220"
                        android:id="@+id/mf_clock_mini_yuanxue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="小海"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:background="@drawable/rounded_color_white"
                    android:paddingLeft="3dp"
                    android:paddingTop="5dp"
                    android:paddingRight="3dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="5dp">
                    <TextView
                        android:textSize="8dp"
                        android:textColor="#ffffff"
                        android:id="@+id/mf_clock_mini_ben"
                        android:background="@drawable/meridian_flowing_clock_item_span"
                        android:paddingLeft="5dp"
                        android:paddingTop="3dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="3dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#262220"
                        android:id="@+id/mf_clock_mini_benxue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="小海"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
