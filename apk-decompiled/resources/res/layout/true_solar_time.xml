<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.Android.AppWidgetContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Android.AppWidget.Container">
    <RelativeLayout
        android:id="@+id/true_solar_time_centre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/true_solar_time_bg"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <LinearLayout
                android:gravity="center"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#262220"
                    android:gravity="center"
                    android:id="@+id/mC_clock_centre_the_lunar_calendar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="系统时间"
                    android:layout_weight="1"
                    android:lineHeight="20dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:src="@drawable/true_solar_time_position"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#262220"
                        android:id="@+id/true_solar_time_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="北京市"
                        android:lineHeight="20dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="20dp">
                <TextClock
                    android:textSize="28dp"
                    android:textColor="#262220"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:lineHeight="40dp"
                    android:textFontWeight="900"/>
                <TextView
                    android:textSize="28dp"
                    android:textColor="#262220"
                    android:gravity="center"
                    android:id="@+id/true_solar_time_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="13:42"
                    android:layout_weight="1"
                    android:lineHeight="40dp"
                    android:textFontWeight="900"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="20dp">
                <TextClock
                    android:textSize="14dp"
                    android:textColor="#262220"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:format12Hour="M月d日"
                    android:format24Hour="M月d日"
                    android:lineHeight="20dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#262220"
                    android:gravity="center"
                    android:id="@+id/true_solar_time_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="3月20日"
                    android:layout_weight="1"
                    android:lineHeight="20dp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
